rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/account_deletion_blocks/$(request.auth.uid));
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myProfile() {
      return userDoc(request.auth.uid);
    }

    function myChurchId() {
      return signedIn() && myProfile().data.church_id is string
        ? myProfile().data.church_id
        : null;
    }

    function sameChurch(churchId) {
      return signedIn() && churchId is string && churchId.size() > 0 && churchId == myChurchId();
    }

    function isAdminForChurch(churchId) {
      return sameChurch(churchId) && myProfile().data.is_admin == true;
    }

    function affectedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function validNewUser(userId) {
      return isSelf(userId)
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'roles',
          'church_id',
          'is_admin',
          'created_at',
          'friendCode',
          'friends'
        ])
        && request.resource.data.church_id == null
        && request.resource.data.is_admin == false;
    }

    function selfProfileUpdate(userId) {
      return isSelf(userId)
        && affectedOnly(['name', 'email', 'roles'])
        && request.resource.data.church_id == resource.data.church_id
        && request.resource.data.is_admin == resource.data.is_admin;
    }

    function selfJoinMinistry(userId) {
      return false; // Membership changes require an authenticated invite endpoint.
    }

    function selfClaimCreatedMinistry(userId) {
      return isSelf(userId)
        && affectedOnly(['church_id', 'is_admin'])
        && resource.data.is_admin != true
        && request.resource.data.is_admin == true
        && request.resource.data.church_id is string
        && getAfter(/databases/$(database)/documents/ministries/$(request.resource.data.church_id)).data.admin_id == userId;
    }

    function adminChangesMember(userId) {
      return signedIn()
        && userId != request.auth.uid
        && sameChurch(resource.data.church_id)
        && isAdminForChurch(resource.data.church_id)
        && affectedOnly(['church_id', 'is_admin'])
        && (
          (
            request.resource.data.church_id == resource.data.church_id
            && request.resource.data.is_admin is bool
          )
          || (
            request.resource.data.church_id == null
            && request.resource.data.is_admin == false
          )
        );
    }

    function mutualFriendUpdate(userId) {
      return false;
    }

    function canReadUser(userId) {
      return isSelf(userId)
        || sameChurch(resource.data.church_id);
    }

    function validInviteCreate() {
      return signedIn()
        && request.resource.data.ministry_id is string
        && request.resource.data.admin_id == request.auth.uid
        && getAfter(/databases/$(database)/documents/ministries/$(request.resource.data.ministry_id)).data.admin_id == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ministry_id',
          'admin_id',
          'created_at'
        ]);
    }

    function scheduleBaseUnchanged() {
      return request.resource.data.church_id == resource.data.church_id
        && request.resource.data.title == resource.data.title
        && request.resource.data.date == resource.data.date
        && request.resource.data.get('created_at', null) == resource.data.get('created_at', null)
        && request.resource.data.get('id', null) == resource.data.get('id', null);
    }

    function scheduleMemberFieldsOnly() {
      return affectedOnly(['team_assignments'])
        || affectedOnly(['suggested_songs']);
    }

    function scheduleTeamMember() {
      return sameChurch(resource.data.church_id)
        && (
          !resource.data.keys().hasAny(['team_uids'])
          || request.auth.uid in resource.data.team_uids
        );
    }

    function adminScheduleUpdate() {
      return isAdminForChurch(resource.data.church_id)
        && request.resource.data.church_id == resource.data.church_id
        && affectedOnly([
          'id',
          'title',
          'date',
          'suggested_songs',
          'approved_songs',
          'team_assignments',
          'team_uids',
          'updated_at'
        ]);
    }

    function memberScheduleUpdate() {
      return false; // The server changes only the caller's response/vote.
    }

    function scheduleChurch(scheduleId) {
      return get(/databases/$(database)/documents/schedules/$(scheduleId)).data.church_id;
    }

    match /users/{userId} {
      allow read: if signedIn() && canReadUser(userId);
      allow create: if validNewUser(userId);
      allow update: if selfProfileUpdate(userId)
        || selfJoinMinistry(userId)
        || selfClaimCreatedMinistry(userId)
        || adminChangesMember(userId)
        || mutualFriendUpdate(userId);
      allow delete: if false;

      match /library/{songId} {
        allow read, create, update, delete: if isSelf(userId);
      }

      match /played_history/{songId} {
        allow read, create, update, delete: if isSelf(userId);
      }

      match /availability/{dateId} {
        allow read: if isSelf(userId)
          || sameChurch(userDoc(userId).data.church_id);
        allow create, update, delete: if isSelf(userId);
      }
    }

    match /ministries/{ministryId} {
      allow get: if signedIn()
        && (
          resource.data.admin_id == request.auth.uid
          || sameChurch(ministryId)
        );
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.admin_id == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'name',
          'invite_code',
          'admin_id',
          'created_at'
        ]);
      allow update: if isAdminForChurch(ministryId);
      allow delete: if false;

      match /official_songs/{songId} {
        allow read: if sameChurch(ministryId);
        allow create, update, delete: if isAdminForChurch(ministryId);

        match /versions/{versionId} {
          allow read: if sameChurch(ministryId);
          allow create, update, delete: if isAdminForChurch(ministryId);
        }
      }
    }

    match /ministry_invites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if validInviteCreate();
      allow update: if signedIn()
        && resource.data.ministry_id is string
        && isAdminForChurch(resource.data.ministry_id)
        && request.resource.data.ministry_id == resource.data.ministry_id
        && request.resource.data.admin_id == resource.data.admin_id
        && request.resource.data.keys().hasOnly([
          'ministry_id',
          'admin_id',
          'created_at'
        ]);
      allow delete: if false;
    }

    match /schedules/{scheduleId} {
      allow read: if sameChurch(resource.data.church_id);
      allow create: if isAdminForChurch(request.resource.data.church_id);
      allow update: if adminScheduleUpdate() || memberScheduleUpdate();
      allow delete: if isAdminForChurch(resource.data.church_id);

      match /rehearsal_status/{statusId} {
        function validPreparation() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'songKey', 'title', 'artist', 'rehearsed',
              'note', 'updated_at', 'preparation', 'arrangementRevision'])
            && d.rehearsed is bool
            && d.songKey.size() > 0 && d.songKey.size() <= 400
            && d.get('title', '') is string && d.get('title', '').size() <= 500
            && d.get('artist', '') is string && d.get('artist', '').size() <= 500
            && d.get('note', '') is string && d.get('note', '').size() <= 1500
            && (!d.keys().hasAny(['preparation'])
              || (d.preparation in ['pending', 'studying', 'ready', 'needsHelp']
                && d.rehearsed == (d.preparation == 'ready')
                && d.arrangementRevision is string
                && d.arrangementRevision.matches('^[a-f0-9]{64}$')));
        }
        allow read: if sameChurch(scheduleChurch(scheduleId));
        allow create, update: if sameChurch(scheduleChurch(scheduleId))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.songKey is string
          && statusId == request.auth.uid + '_' + request.resource.data.songKey
          && validPreparation()
          && (!exists(/databases/$(database)/documents/schedules/$(scheduleId)/rehearsal_status/$(statusId))
            || resource.data.uid == request.auth.uid);
        allow delete: if isAdminForChurch(scheduleChurch(scheduleId));
      }
    }

    match /setlists/{setlistId} {
      allow read: if signedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || request.auth.uid in resource.data.sharedWith
        );
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          (resource.data.ownerId == request.auth.uid
            && affectedOnly(['title', 'songIds', 'sharedWith', 'updatedAt']))
          || (request.auth.uid in resource.data.get('sharedWith', [])
            && (
              (affectedOnly(['songIds', 'updatedAt'])
                && request.resource.data.songIds is list
                && request.resource.data.songIds.hasAll(resource.data.get('songIds', [])))
              || (affectedOnly(['sharedWith'])
                && request.resource.data.sharedWith == resource.data.sharedWith.removeAll([request.auth.uid]))
            ))
        );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /songs/{songId} {
        function parentAfterWrite() {
          return getAfter(/databases/$(database)/documents/setlists/$(setlistId)).data;
        }
        function canAccessParent(data) {
          return signedIn() && (data.ownerId == request.auth.uid
            || request.auth.uid in data.get('sharedWith', []));
        }
        // Queries read committed state; getAfter is only for atomic writes.
        allow read: if canAccessParent(get(/databases/$(database)/documents/setlists/$(setlistId)).data);
        allow create: if canAccessParent(parentAfterWrite())
          && request.resource.data.created_by == request.auth.uid
          && songId in parentAfterWrite().songIds
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 120000;
        allow update, delete: if false;
      }
    }

    match /songs/{songId} {
      allow read, create: if false;
      allow update, delete: if false;
    }

    match /public_profiles/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /global_cifras/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /cifras_globais/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /support_tickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.type in [
          'bug',
          'wrong_chord',
          'question',
          'suggestion'
        ]
        && request.resource.data.severity in [
          'critical',
          'high',
          'medium',
          'low'
        ]
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 8
        && request.resource.data.message.size() <= 1200
        && request.resource.data.user.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.source == 'app';
      allow read: if signedIn() && resource.data.user.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /artist_aliases/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
